{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HIS XML Sync",
  "version": "0.1.0",
  "identifier": "vn.vietnga.hisxmlsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HIS XML Sync",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Viet Nga",
    "category": "Medical",
    "shortDescription": "Đồng bộ kết quả khúc xạ XML sang HIS",
    "longDescription": "HIS XML Sync đọc file XML thiết bị nhãn khoa (TOPCON KR-800), map dữ liệu thị lực và gửi kết quả lên hệ thống HIS. Ứng dụng desktop Windows-first, đóng gói đầy đủ runtime.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Viet Nga"
      }
    }
  }
}
